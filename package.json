{
  "name": "bearded-giant-sites",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:llc": "vite --config sites/llc/vite.config.js",
    "dev:bbq": "vite --config sites/bbq/vite.config.js",
    "dev:ai": "vite --config sites/ai/vite.config.js",
    "build:llc": "vite build --config sites/llc/vite.config.js",
